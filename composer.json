{
    "name": "digitalize/sms",
    "description": "PHP client for the Digitalize Lab SMS API: OTP and alert messages from approved templates.",
    "type": "library",
    "license": "MIT",
    "keywords": ["sms", "otp", "sudan", "digitalize", "laravel"],
    "homepage": "https://digitalize.sd/developers/sms",
    "authors": [{ "name": "Digitalize Lab", "homepage": "https://digitalize.sd" }],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "illuminate/notifications": "^10.0 || ^11.0 || ^12.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0"
    },
    "suggest": {
        "illuminate/support": "Laravel integration: config, facade and notification channel (auto-discovered)"
    },
    "autoload": {
        "psr-4": { "Digitalize\\Sms\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Digitalize\\Sms\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": ["Digitalize\\Sms\\Laravel\\DigitalizeSmsServiceProvider"],
            "aliases": { "DigitalizeSms": "Digitalize\\Sms\\Laravel\\DigitalizeSms" }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
